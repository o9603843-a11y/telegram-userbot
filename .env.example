# Telegram API ma'lumotlari (https://my.telegram.org saytidan olinadi)
API_ID=
API_HASH=

# Sessiya fayli nomi yoki StringSession (Google Cloud uchun juda qulay)
SESSION_NAME=userbot_session
STRING_SESSION=

# Standart avtojavob matni
AUTO_REPLY_TEXT=Assalomu alaykum! Hozirda bandman yoki tarmoqda emasman. Xabaringizni ko'rganim zahoti sizga javob yozaman.

# Har bir foydalanuvchiga faqat 1 marta javob berish (True yoki False)
REPLY_ONCE=True

# Yangi xabar kelganda "Saqlangan xabarlar" (Saved Messages) ga bildirishnoma yuborish (True yoki False)
NOTIFY_ME=True

# Maxsus bot orqali bildirishnoma olish (@BotFather bergan token)
BOT_TOKEN=

# Buyruqlar prefiksi (masalan: .status, .settext)
CMD_PREFIX=.
